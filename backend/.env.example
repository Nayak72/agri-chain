# AgriChain Backend Production Configuration
# Copy or set these environment variables in your deployment environment (e.g. Render Dashboard).

APP_ENV=production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=agri_chain_demo
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://YOUR-APP.vercel.app
ALLOW_STANDALONE_DEV=false
UPLOAD_DIRECTORY=uploads
LOG_LEVEL=INFO
